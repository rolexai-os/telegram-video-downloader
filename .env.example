# Telegram BotFather token
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Local download directory
DOWNLOAD_DIR=downloads

# Keep below the normal Telegram Bot API upload limit
MAX_FILE_SIZE_MB=49

# Maximum simultaneous yt-dlp downloads across all users/devices
MAX_CONCURRENT_DOWNLOADS=2

# Maximum links accepted in one message/command
MAX_LINKS_PER_MESSAGE=5

# Maximum active/queued jobs per Telegram user
MAX_QUEUE_PER_USER=10

# Minimum seconds between new requests from the same Telegram user
RATE_LIMIT_SECONDS=2

# Optional comma-separated Telegram numeric user IDs with admin status
# ADMIN_USER_IDS=123456789,987654321

# Optional: path to an authorized yt-dlp cookies.txt file
# COOKIES_FILE=/absolute/path/to/cookies.txt
