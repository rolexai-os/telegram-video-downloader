# Telegram BotFather token — KEEP THIS SECRET
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Temporary/local download directory
DOWNLOAD_DIR=downloads

# Maximum file size the bot will upload (Telegram/server limits still apply)
MAX_FILE_SIZE_MB=49

# Global simultaneous yt-dlp downloads.
MAX_CONCURRENT_DOWNLOADS=2

# 0 = unlimited links per message (subject to Telegram/server resources)
MAX_LINKS_PER_MESSAGE=0

# 0 = unlimited queued jobs per Telegram user
MAX_QUEUE_PER_USER=0

# Minimum seconds between new requests from the same Telegram user
RATE_LIMIT_SECONDS=2

# Optional comma-separated Telegram numeric user IDs with admin status
# ADMIN_USER_IDS=123456789,987654321

# Optional authorized yt-dlp cookies file. Keep it private.
# COOKIES_FILE=/absolute/path/to/cookies.txt

# Robust yt-dlp network handling
YTDLP_MAX_ATTEMPTS=3
YTDLP_RETRY_DELAY=2
# Set to 1 if your network has IPv6-related 403/connectivity problems
YTDLP_FORCE_IPV4=0
# Optional browser User-Agent; leave empty to use the built-in fallback on retry
YTDLP_USER_AGENT=
