# Telegram BotFather token — KEEP THIS SECRET
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_MB=49
MAX_CONCURRENT_DOWNLOADS=4
MAX_LINKS_PER_MESSAGE=0
MAX_QUEUE_PER_USER=0
RATE_LIMIT_SECONDS=2

# Optional admin IDs
# ADMIN_USER_IDS=123456789,987654321

# Optional authorized yt-dlp cookies
# COOKIES_FILE=/absolute/path/to/cookies.txt

# Robust yt-dlp retry/network settings
YTDLP_MAX_ATTEMPTS=3
YTDLP_RETRY_DELAY=2
YTDLP_FORCE_IPV4=0
# YTDLP_USER_AGENT=
