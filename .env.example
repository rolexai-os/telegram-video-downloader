# Telegram BotFather token — KEEP THIS SECRET
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

DOWNLOAD_DIR=downloads
DB_FILE=bot.db
MAX_FILE_SIZE_MB=49
MAX_CONCURRENT_DOWNLOADS=4
MAX_LINKS_PER_MESSAGE=0
MAX_QUEUE_PER_USER=0
RATE_LIMIT_SECONDS=2
PLAYLIST_MAX_ITEMS=10
PROGRESS_UPDATE_SECONDS=3
DEFAULT_AUDIO_QUALITY=192

# Optional admin Telegram user IDs, comma separated
# ADMIN_USER_IDS=123456789,987654321

# Platform-specific authorized yt-dlp cookies. Use only cookies you are authorized to use.
COOKIES_DIR=cookies
# Optional legacy fallback:
# COOKIES_FILE=/absolute/path/to/cookies.txt
# Optional explicit per-platform overrides:
# COOKIES_YOUTUBE=
# COOKIES_INSTAGRAM=
# COOKIES_FACEBOOK=
# COOKIES_TIKTOK=
# COOKIES_X=
# COOKIES_REDDIT=
# COOKIES_VIMEO=
# COOKIES_DAILYMOTION=
# COOKIES_SNAPCHAT=
# COOKIES_PINTEREST=
# COOKIES_LINKEDIN=
# COOKIES_TWITCH=
# COOKIES_THREADS=
# COOKIES_TELEGRAM=
# COOKIES_GENERIC=
# On Render Docker services, Secret Files are mounted under /etc/secrets/.
# Example: COOKIES_YOUTUBE=/etc/secrets/youtube.txt

# Robust yt-dlp retry/network settings
YTDLP_MAX_ATTEMPTS=3
YTDLP_RETRY_DELAY=2
YTDLP_FORCE_IPV4=0
# YTDLP_USER_AGENT=

# Render/webhook values are normally supplied by Render
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=generate-a-long-random-secret
# PORT=10000

# Optional external database roadmap setting.
# DB_BACKEND=sqlite
# DATABASE_URL=


# Telegram Bot API reliability / session monitoring
TG_CONNECT_TIMEOUT=20
TG_READ_TIMEOUT=45
TG_WRITE_TIMEOUT=90
TG_POOL_TIMEOUT=20
TG_MEDIA_WRITE_TIMEOUT=180
TG_CONNECTION_POOL=32
TG_HTTP_RETRIES=3
TG_UPDATES_TIMEOUT=35
TG_WATCHDOG_INTERVAL=60
RUNNER_RESTART_DELAY=5
# Optional lock location for local/Termux single-instance protection:
# BOT_INSTANCE_LOCK=.bot-instance.lock
