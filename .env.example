# Telegram BotFather token — KEEP THIS SECRET
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

DOWNLOAD_DIR=downloads
DB_FILE=bot.db
# 0 = no application-side source size cap. Telegram delivery is still limited by the configured Bot API.
MAX_FILE_SIZE_MB=0
TELEGRAM_UPLOAD_CHUNK_MB=45
# 0 = no application quota; actual disk/object-storage capacity still applies.
STORAGE_QUOTA_GB=0
STORAGE_BACKEND=local
KEEP_MEDIA=0
APP_LOG_FILE=bot.log
MAX_CONCURRENT_DOWNLOADS=4
MAX_LINKS_PER_MESSAGE=0
MAX_QUEUE_PER_USER=0
RATE_LIMIT_SECONDS=2
PLAYLIST_MAX_ITEMS=10
PROGRESS_UPDATE_SECONDS=3
DEFAULT_AUDIO_QUALITY=192

# Bot owner Telegram user ID. Only this user can add/remove administrators.
# BOT_OWNER_ID=123456789
# Bootstrap administrator Telegram user IDs, comma separated. These are persisted to SQLite on startup.
# ADMIN_USER_IDS=123456789,987654321

# Audit/server visibility
LOG_URLS=1
# Privacy: this build does not read cookies, browser profiles, or session tokens.
# Authentication-required media is skipped rather than using stored sessions.
# Optional explicit server identity. Auto-detected as Render or local when unset.
# SERVER_KIND=local
# SERVER_NAME=My Termux phone
# SERVER_ID=local:my-phone
SERVER_HEARTBEAT_INTERVAL=30

YTDLP_MAX_ATTEMPTS=3
YTDLP_RETRY_DELAY=2
YTDLP_FORCE_IPV4=0
# YTDLP_USER_AGENT=

# Render/webhook values are normally supplied by Render
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=generate-a-long-random-secret
# PORT=10000

TG_CONNECT_TIMEOUT=20
TG_READ_TIMEOUT=45
TG_WRITE_TIMEOUT=90
TG_POOL_TIMEOUT=20
TG_MEDIA_WRITE_TIMEOUT=180
TG_CONNECTION_POOL=32
TG_HTTP_RETRIES=3
TG_UPDATES_TIMEOUT=35
TG_WATCHDOG_INTERVAL=60
RUNNER_RESTART_DELAY=5
# Optional lock location for local/Termux single-instance protection:
# BOT_INSTANCE_LOCK=.bot-instance.lock
